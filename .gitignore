# Runtime output — logs, exports, backups. Regenerated by the app on demand.
/data/
industrybench/data/

# Local config store: real instrument serial numbers, site-specific export
# paths, named projects. A fresh clone regenerates it from
# industrybench/config/defaults.py. Anchored, so the config *package* stays
# tracked — only its runtime files are excluded.
/config/
industrybench/config/*.json
*.db
*.db-shm
*.db-wal

# Vendor programming guides — large binaries, redistributed by the manufacturer
*.chm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Editors / IDEs
.idea/
.vscode/

# OS cruft
Thumbs.db
desktop.ini
.DS_Store
